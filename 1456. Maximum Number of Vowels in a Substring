class Solution:
    def maxVowels(self, s: str, k: int) -> int:
        i=0
        v="aeiou"
        m=0
        c=0
        for j in range(len(s)):
            if s[j] in v:
                c=c+1
            if j-i+1==k:
                m=max(m,c)
                if s[i] in v:
                    c=c-1
                i=i+1
        return m
