class Solution:
    def numOfSubarrays(self, arr: list[int], k: int, threshold: int) -> int: 
        i=0
        j=0
        w_s=0
        n=len(arr)
        c=0
        avg=0
        while(j < n):
            w_s=w_s+arr[j]
            if j-i+1!=k:
                j=j+1
            elif j-i+1==k:
                if w_s>=threshold*k:
                    c=c+1
                w_s=w_s-arr[i]
                i=i+1
                j=j+1
        return c