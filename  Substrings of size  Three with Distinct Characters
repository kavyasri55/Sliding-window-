class Solution:
    def countGoodSubstrings(self, s: str) -> int:
        i=0
        j=0
        co=0
        while(j<len(s)):
            if j-i+1!=3:
                j=j+1
            elif j-i+1==3:
                if s[i]!=s[i+1] and s[i+1]!=s[j] and s[i]!=s[j]:
                    co=co+1
                i=i+1
                j=j+1
                
        return co